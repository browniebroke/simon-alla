{
  "name": "simon-alla",
  "private": true,
  "description": "Website for L'atelier Pierre & Paysage (Simon Alla): Astro site + Sanity Studio",
  "workspaces": [
    "web",
    "studio"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:studio": "npm run dev -w studio",
    "build:web": "npm run build -w web",
    "deploy:studio": "npm run deploy -w studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2"
  }
}

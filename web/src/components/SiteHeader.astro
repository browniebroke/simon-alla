---
import {splitName, telHref} from '../lib/format'
import type {SiteSettings} from '../lib/sanity'

interface Props {
  settings: SiteSettings
}
const {settings} = Astro.props
const [first, last] = splitName(settings.name)

const links = [
  {href: '/services/', label: 'Services'},
  {href: '/realisations/', label: 'Réalisations'},
  {href: '/contact/', label: 'Contact'},
]
const current = Astro.url.pathname
---

<header class="header">
  <div class="container inner">
    <a class="brand" href="/">
      {first} <span>{last}</span>
    </a>
    <nav aria-label="Navigation principale">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="button button--yellow phone" href={telHref(settings.phone)}>
      {settings.phone}
    </a>
  </div>
</header>

<style>
  .header {
    background: var(--forest);
    color: var(--white);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    padding-block: 16px;
  }
  .brand {
    font-weight: 700;
    font-size: 1.5rem;
    text-decoration: none;
    margin-right: auto;
  }
  .brand span {
    color: var(--olive);
  }
  ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    font-weight: 500;
    opacity: 0.9;
  }
  nav a[aria-current='page'] {
    color: var(--yellow);
    opacity: 1;
  }
  nav a:hover {
    color: var(--yellow);
    opacity: 1;
  }
  .phone {
    padding: 0.5em 1.1em;
  }
  @media (max-width: 720px) {
    .phone {
      display: none; /* replaced by the sticky call button */
    }
    nav {
      width: 100%;
    }
  }
</style>

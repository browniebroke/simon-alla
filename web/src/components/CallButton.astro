---
import {site} from '../data/placeholder'
---

<a class="call button button--yellow" href={site.phoneHref} aria-label={`Appeler le ${site.phone}`}>
  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <path
      fill="currentColor"
      d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"
    ></path>
  </svg>
  Appeler
</a>

<style>
  .call {
    display: none;
  }
  @media (max-width: 720px) {
    .call {
      display: inline-flex;
      position: fixed;
      right: 16px;
      bottom: 16px;
      z-index: 10;
      box-shadow: 0 8px 24px rgb(0 0 0 / 30%);
    }
  }
</style>

---
/** Round photo with a thick yellow ring, as in the flyer's hero. */
import {imageUrl, srcSet} from '../lib/image'
import type {Photo} from '../lib/sanity'

interface Props {
  photo: Photo
  size?: string
  /** Logos are shown whole (contain) rather than cropped to fill the circle. */
  contain?: boolean
}
const {photo, size = 'min(80vw, 340px)', contain = false} = Astro.props
---

<div class="ring" class:list={{contain}} style={`--size:${size}`}>
  <img
    src={imageUrl(photo, 680, 680)}
    srcset={srcSet(photo, [340, 520, 680], 1)}
    sizes={size}
    alt={photo.alt ?? ''}
    width="680"
    height="680"
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .ring {
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
    border: clamp(6px, 1.2vw, 10px) solid var(--yellow);
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 20px 50px rgb(0 0 0 / 30%);
    flex-shrink: 0;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .contain img {
    object-fit: contain;
  }
</style>

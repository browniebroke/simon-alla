---
/** Round photo with a thick yellow ring, as in the flyer's hero. */
interface Props {
  src: string
  alt: string
  size?: string
}
const {src, alt, size = 'min(80vw, 340px)'} = Astro.props
---

<div class="ring" style={`--size:${size}`}>
  <img src={src} alt={alt} width="600" height="600" loading="eager" decoding="async" />
</div>

<style>
  .ring {
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
    border: clamp(6px, 1.2vw, 10px) solid var(--yellow);
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 20px 50px rgb(0 0 0 / 30%);
    flex-shrink: 0;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

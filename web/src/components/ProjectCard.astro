---
import {monthYear} from '../lib/format'
import {imageUrl, srcSet} from '../lib/image'
import type {ProjectSummary} from '../lib/sanity'

interface Props {
  project: ProjectSummary
}
const {project} = Astro.props
const meta = [project.town, monthYear(project.date)].filter(Boolean).join(' · ')
---

<article class="card">
  <img
    src={imageUrl(project.coverImage, 600, 450)}
    srcset={srcSet(project.coverImage, [400, 600, 900], 3 / 4)}
    sizes="(max-width: 640px) 100vw, 360px"
    alt={project.coverImage.alt ?? ''}
    width="600"
    height="450"
    loading="lazy"
    decoding="async"
  />
  <div class="body">
    {project.service && <p class="service">{project.service.title}</p>}
    <h3>
      <a href={`/realisations/${project.slug}/`}>{project.title}</a>
    </h3>
    <p class="meta">{meta}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    height: 100%;
    transition: transform 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
  }
  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .body {
    padding: 18px 20px 20px;
  }
  .service {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--olive);
    margin: 0 0 4px;
  }
  h3 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--forest);
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .meta {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>

---
import ContactBox from '../../components/ContactBox.astro'
import PageHeader from '../../components/PageHeader.astro'
import ServiceGrid from '../../components/ServiceGrid.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {getServices, getSettings} from '../../lib/sanity'

const [settings, services] = await Promise.all([getSettings(), getServices()])
---

<BaseLayout
  title="Services"
  description={`Les services de ${settings.name} : ${services.map((s) => s.title.toLowerCase()).join(', ')}.`}
>
  <PageHeader title="Les services" lead={settings.tagline} />
  <section class="container list">
    <ServiceGrid services={services} showImages />
  </section>
  <ContactBox />
</BaseLayout>

<style>
  .list {
    padding-top: calc(var(--section-y) / 2);
  }
</style>

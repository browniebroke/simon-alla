---
import PageHeader from '../components/PageHeader.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Page introuvable">
  <PageHeader title="Page introuvable" lead="Cette page n’existe pas ou a été déplacée." />
  <section class="container content">
    <p>
      <a class="button button--yellow" href="/">
        Retour à l’accueil
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .content {
    padding-top: calc(var(--section-y) / 2);
  }
</style>

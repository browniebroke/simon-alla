{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Worker name on Cloudflare (also in the workers.dev URL).
  "name": "simon-alla",
  // Bruno Alla's Account: pins deploys to this account whatever credentials are in the shell.
  "account_id": "a5251ea58358674463cdcbe404b884bf",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-17",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  // Cloudflare Email Service: sends the contact form messages to Simon.
  "send_email": [{"name": "EMAIL"}],
  "vars": {
    // Sender address: its domain must be onboarded with `wrangler email sending enable <domain>`.
    // Leave empty until the domain is set up: the form then answers with an error.
    "CONTACT_FROM_EMAIL": "",
    "CONTACT_FROM_NAME": "Site L’atelier Pierre & Paysage",
  },
  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  // - TURNSTILE_SECRET_KEY
}

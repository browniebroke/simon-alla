{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Worker name on Cloudflare (also in the workers.dev URL).
  "name": "simon-alla",
  // Bruno Alla's Account: pins deploys to this account whatever credentials are in the shell.
  "account_id": "a5251ea58358674463cdcbe404b884bf",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-17",
  // simonalla.fr is attached as a Custom Domain (Cloudflare creates the DNS record).
  // www.simonalla.fr is redirected to it by a Redirect Rule on the zone, not by the Worker.
  "routes": [{"pattern": "simonalla.fr", "custom_domain": true}],
  // Production is only served on simonalla.fr (no *.workers.dev address).
  "workers_dev": false,
  // Pull request previews (`wrangler preview`, see .github/workflows/preview.yml) get a
  // pr-<n>-simon-alla.<subdomain>.workers.dev URL, which Cloudflare marks noindex.
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  // Contact form messages go out through Email Routing on simonalla.fr. On the Workers Free
  // plan this can only send to *verified* destination addresses (Email Routing in the
  // Cloudflare dashboard), which is fine: the form only ever writes to Simon.
  "send_email": [{"name": "EMAIL", "allowed_sender_addresses": ["site@simonalla.fr"]}],
  "vars": {
    "CONTACT_FROM_EMAIL": "site@simonalla.fr",
    "CONTACT_FROM_NAME": "Site L’atelier Pierre & Paysage",
    // "true" logs contact emails instead of sending them (set in .dev.vars for local dev).
    "EMAIL_DRY_RUN": "false",
    // Hostnames the Turnstile token may come from (checked against siteverify's answer).
    "TURNSTILE_HOSTNAMES": "simonalla.fr",
  },
  // Secrets: set with `npx wrangler secret put <NAME>`, never committed.
  // Declared here so `wrangler types` doesn't depend on a local .dev.vars.
  "secrets": {"required": ["TURNSTILE_SECRET_KEY"]},
  // Previews don't inherit production settings. They use Turnstile's public test keys
  // and never send email: the contact form logs the message instead. Their
  // TURNSTILE_SECRET_KEY (the test secret) is a Previews base secret, see README.
  "previews": {
    "send_email": [{"name": "EMAIL"}],
    "vars": {
      "CONTACT_FROM_EMAIL": "",
      "CONTACT_FROM_NAME": "Site L’atelier Pierre & Paysage (preview)",
      "EMAIL_DRY_RUN": "true",
      // Turnstile's test secret answers with this hostname.
      "TURNSTILE_HOSTNAMES": "example.com",
    },
  },
}

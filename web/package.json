{
  "name": "@simon-alla/web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "wrangler types --strict-vars=false && astro dev",
    "build": "wrangler types --strict-vars=false && astro check && astro build",
    "preview": "wrangler types --strict-vars=false && astro preview",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "lint": "eslint .",
    "typecheck": "wrangler types --strict-vars=false && astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@portabletext/to-html": "6.0.0",
    "@portabletext/types": "4.0.2",
    "@sanity/client": "8.17.0",
    "@sanity/image-url": "2.2.0",
    "astro": "7.4.13"
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "wrangler": "4.167.0"
  }
}
